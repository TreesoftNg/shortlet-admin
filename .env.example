# Copy to `.env` and adjust. Every value here is public (shipped to the
# browser), so never put secrets in this file.

# Shortlet API base URL, including the version prefix.
# Admin routes are called under /cc (e.g. /cc/auth/login).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Required on localhost/preview when the API cannot resolve tenant from Origin.
# Example staging value: sunmade
NEXT_PUBLIC_TENANT_SLUG=
